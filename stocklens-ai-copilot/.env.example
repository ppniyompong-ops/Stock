PORT=3000
# API secrets stay on the server. Never put them in public/ or commit .env.
FINNHUB_API_KEY=replace_with_your_finnhub_key
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Neon Console → Connect → copy the pooled PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
# Comma-separated symbols updated by the scheduled job; Finnhub coverage varies by plan.
MARKET_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,GOOGL,AMZN,META
